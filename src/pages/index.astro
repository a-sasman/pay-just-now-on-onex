---
import CourseNav from "../components/CourseNav.astro";
import KnowledgeCheck from "../components/KnowledgeCheck.astro";
import ProductSort from "../components/ProductSort.astro";
import ScormRuntime from "../components/ScormRuntime.astro";
import ZoomImage from "../components/ZoomImage.astro";
import { courseData } from "../data/payjustnow-course";
import CourseLayout from "../layouts/CourseLayout.astro";

const checks = courseData.knowledgeChecks;
---

<CourseLayout title="Content">
  <div id="top"></div>

  <CourseNav
    brandName={courseData.meta.brand}
    logoSrc={courseData.meta.logoSrc}
    sections={courseData.navSections}
  />

  <main>
    <section class="onex-section welcome-section scroll-mt-28" id="welcome">
      <div class="container">
        <div class="welcome-panel reveal">
          <div class="welcome-copy">
            <p class="section-kicker section-kicker-lime">Welcome</p>
            <h1>{courseData.welcome.title}</h1>
            <p>{courseData.welcome.intro}</p>
          </div>
          <img
            class="welcome-image"
            src={courseData.welcome.imageSrc}
            alt={courseData.welcome.imageAlt}
          />
        </div>

        <div class="outcomes-panel reveal">
          <div>
            <p class="section-kicker">What you will learn</p>
            <h2>{courseData.welcome.outcomesIntro}</h2>
          </div>
          <ul class="outcomes-list">
            {courseData.welcome.outcomes.map((outcome) => (
              <li><span aria-hidden="true">✓</span>{outcome}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="onex-section sale-journey-section scroll-mt-28" id="sale-journey">
      <div class="container">
        <div class="section-heading centered reveal">
          <h2>{courseData.saleJourney.title}</h2>
          {courseData.saleJourney.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="journey-shell reveal">
          <div class="journey-copy">
            <h3>PayJustNow checkout</h3>
            <p>
              Open the supplied screen for a larger view. The remaining oneX POS journey screens
              are still required to show the complete ordered process without fabricating steps.
            </p>
          </div>
          <ZoomImage
            id="payment-plan-zoom"
            src={courseData.saleJourney.screenshotSrc}
            alt={courseData.saleJourney.screenshotAlt}
            caption=""
          />
        </div>
      </div>
    </section>

    <section class="onex-section rules-section scroll-mt-28" id="sale-rules">
      <div class="container">
        <div class="section-heading centered dark-heading reveal">
          <h2>{courseData.rules.title}</h2>
          <p>{courseData.rules.intro}</p>
        </div>

        <div class="connected-cards four-rule-cards" data-rule-cards>
          {courseData.rules.items.map((rule, index) => (
            <button type="button" class="connected-card rule-card reveal" aria-pressed="false">
              <span class="card-number">{index + 1}</span>
              <span>{rule}</span>
            </button>
          ))}
        </div>

        <KnowledgeCheck
          id={checks[0].id}
          number={1}
          total={checks.length}
          question={checks[0].question}
          options={checks[0].options}
          correctIndex={checks[0].correctIndex}
          feedback={checks[0].feedback}
        />
      </div>
    </section>

    <section class="onex-section exclusions-section">
      <div class="container">
        <div class="exclusions-panel reveal">
          <div class="exclusions-copy">
            <h2>{courseData.exclusions.title}</h2>
            {courseData.exclusions.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <img
            src={courseData.saleJourney.screenshotSrc}
            alt={courseData.saleJourney.screenshotAlt}
            class="exclusions-image"
            loading="lazy"
          />
        </div>

        <ProductSort items={courseData.exclusions.sortItems} />

        <KnowledgeCheck
          id={checks[1].id}
          number={2}
          total={checks.length}
          question={checks[1].question}
          options={checks[1].options}
          correctIndex={checks[1].correctIndex}
          feedback={checks[1].feedback}
        />
      </div>
    </section>

    <section class="onex-section refunds-section scroll-mt-28" id="refunds">
      <div class="container">
        <div class="section-heading refund-decision-heading centered reveal">
          <h2>{courseData.refundDecision.title}</h2>
          <p class="decision-question">{courseData.refundDecision.question}</p>
          <p class="decision-reminder">{courseData.refundDecision.reminder}</p>
        </div>

        <div class="refund-paths reveal">
          {courseData.refundDecision.paths.map((path) => (
            <article class="refund-path-card">
              <strong>{path.label}</strong>
              <p>{path.body}</p>
            </article>
          ))}
        </div>

        <div class="refund-checks-panel reveal">
          <div class="section-heading centered">
            <h2>{courseData.refundChecks.title}</h2>
            <p>{courseData.refundChecks.intro}</p>
          </div>
          <div class="connected-cards three-check-cards">
            {courseData.refundChecks.items.map((check, index) => (
              <article class="connected-card refund-check-card">
                <span class="card-number">{index + 1}</span>
                <p>{check}</p>
              </article>
            ))}
          </div>
        </div>

        <KnowledgeCheck
          id={checks[2].id}
          number={3}
          total={checks.length}
          question={checks[2].question}
          options={checks[2].options}
          correctIndex={checks[2].correctIndex}
          feedback={checks[2].feedback}
        />

        <KnowledgeCheck
          id={checks[3].id}
          number={4}
          total={checks.length}
          question={checks[3].question}
          options={checks[3].options}
          correctIndex={checks[3].correctIndex}
          feedback={checks[3].feedback}
        />
      </div>
    </section>

    <section class="onex-section questions-section scroll-mt-28" id="customer-questions">
      <div class="container">
        <div class="section-heading centered dark-heading reveal">
          <h2>{courseData.customerQuestions.title}</h2>
          <p>{courseData.customerQuestions.intro}</p>
          <p><strong>{courseData.customerQuestions.instruction}</strong></p>
        </div>

        <div class="faq-list reveal">
          {courseData.customerQuestions.items.map((item, index) => (
            <details class="faq-item">
              <summary>
                <span class="faq-number">{String(index + 1).padStart(2, "0")}</span>
                <span>{item.question}</span>
              </summary>
              <div class="faq-answer"><p>{item.answer}</p></div>
            </details>
          ))}
        </div>

        <div class="centered-actions reveal">
          <a class="primary-button" href={courseData.guide.href} download>
            {courseData.guide.label}
          </a>
        </div>
      </div>
    </section>

    <section class="onex-section complete-section scroll-mt-28" id="complete">
      <div class="container">
        <div class="complete-panel reveal">
          <img
            src="./images/payjustnow/payjustnow-wrap-up.png"
            alt="PayJustNow wrap-up checklist among pink shapes"
            loading="lazy"
          />
          <div>
            <h2>{courseData.complete.title}</h2>
            {courseData.complete.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="course-footer" aria-label="Course footer">
    <div class="container">
      <div class="course-footer-shell reveal">
        <p class="course-footer-text">Return to People Connect to continue</p>
      </div>
    </div>
  </footer>

  <ScormRuntime />
</CourseLayout>

<script is:inline>
  document.querySelectorAll("[data-rule-cards] .rule-card").forEach((card) => {
    card.addEventListener("click", () => {
      const selected = card.getAttribute("aria-pressed") === "true";
      card.setAttribute("aria-pressed", String(!selected));
    });
  });
</script>
